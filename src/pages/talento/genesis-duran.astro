<script>
  // Animación de entrada del hero
  document.addEventListener("DOMContentLoaded", () => {
    const heroSection = document.querySelector(
      ".hero-section-genesis",
    ) as HTMLElement;
    const heroBanner = document.querySelector(
      ".hero-banner-genesis",
    ) as HTMLElement;
    const heroContent = document.querySelector(
      ".hero-content-genesis",
    ) as HTMLElement;
    const heroText = document.querySelector(
      ".hero-text-genesis",
    ) as HTMLElement;
    const heroName = document.querySelector(
      ".hero-name-genesis",
    ) as HTMLElement;
    const heroSubtitle = document.querySelector(
      ".hero-subtitle-genesis",
    ) as HTMLElement;

    if (
      !heroSection ||
      !heroBanner ||
      !heroContent ||
      !heroText ||
      !heroName ||
      !heroSubtitle
    )
      return;

    // Calcular la altura del contenido completo antes de ocultar elementos
    // Primero guardamos el texto original del subtítulo
    const bio =
      heroSubtitle.getAttribute("data-bio") || heroSubtitle.textContent || "";

    // Creamos un elemento temporal con todo el contenido para medir
    const tempDiv = document.createElement("div");
    tempDiv.style.visibility = "hidden";
    tempDiv.style.position = "absolute";
    tempDiv.style.width = heroText.offsetWidth + "px";
    tempDiv.style.padding = window.getComputedStyle(heroText).padding;
    tempDiv.style.fontSize = window.getComputedStyle(heroText).fontSize;
    tempDiv.style.fontFamily = window.getComputedStyle(heroText).fontFamily;
    tempDiv.style.lineHeight = window.getComputedStyle(heroText).lineHeight;

    const tempGreeting = heroName.previousElementSibling?.cloneNode(
      true,
    ) as HTMLElement;
    const tempName = heroName.cloneNode(true) as HTMLElement;
    const tempSubtitle = heroSubtitle.cloneNode(true) as HTMLElement;

    if (tempGreeting) tempDiv.appendChild(tempGreeting);
    tempDiv.appendChild(tempName);
    if (tempSubtitle) {
      // Reemplazar el marcador [BR] con un <br> real para calcular la altura correcta
      const bioWithBr = bio.replace(/\[BR\]/g, "<br>");
      tempSubtitle.innerHTML = bioWithBr;
      // Asegurar que el tempSubtitle tenga los mismos estilos que el original
      tempSubtitle.style.width = window.getComputedStyle(heroSubtitle).width;
      tempSubtitle.style.fontSize =
        window.getComputedStyle(heroSubtitle).fontSize;
      tempSubtitle.style.lineHeight =
        window.getComputedStyle(heroSubtitle).lineHeight;
      tempSubtitle.style.fontFamily =
        window.getComputedStyle(heroSubtitle).fontFamily;
      tempSubtitle.style.marginBottom =
        window.getComputedStyle(heroSubtitle).marginBottom;
      tempDiv.appendChild(tempSubtitle);
    }

    document.body.appendChild(tempDiv);
    const calculatedHeight = tempDiv.offsetHeight;
    const subtitleHeight = tempSubtitle ? tempSubtitle.offsetHeight : 0;
    document.body.removeChild(tempDiv);

    // Establecer la altura mínima calculada en el contenedor de texto
    // Usar la altura real calculada del subtítulo completo
    heroText.style.minHeight = calculatedHeight + "px";
    heroSubtitle.style.minHeight = subtitleHeight + "px";

    // El nombre ya está oculto inicialmente por CSS, solo limpiamos el subtítulo
    heroSubtitle.style.opacity = "0";
    heroSubtitle.textContent = "";

    // Nombre aparece a los 1 segundo (1000ms) desde la izquierda
    // La transición ya está definida en CSS, solo cambiamos los valores
    setTimeout(() => {
      heroName.style.opacity = "1";
      heroName.style.transform = "translateX(0)";
    }, 1000);

    // Subtítulo aparece letra por letra después del nombre
    // Primero hacemos visible el contenedor del subtítulo
    heroSubtitle.style.opacity = "1";

    let currentCharIndex = 0;
    const showNextChar = () => {
      if (currentCharIndex < bio.length) {
        // Verificar si es un marcador de salto de línea
        if (bio.substring(currentCharIndex, currentCharIndex + 4) === "[BR]") {
          const br = document.createElement("br");
          heroSubtitle.appendChild(br);
          currentCharIndex += 4;
          setTimeout(showNextChar, 100);
          return;
        }

        const char = bio[currentCharIndex];
        const span = document.createElement("span");
        span.textContent = char === " " ? "\u00A0" : char;
        span.style.opacity = "0";
        span.style.display = "inline";
        heroSubtitle.appendChild(span);

        setTimeout(() => {
          span.style.transition = "opacity 0.2s ease-in-out";
          span.style.opacity = "1";
        }, 10);

        currentCharIndex++;
        // Velocidad de lectura: delay entre letras
        const delay = char === " " ? 100 : 50; // Pausa más larga en espacios
        setTimeout(showNextChar, delay);
      }
    };

    // Iniciar animación del subtítulo después del nombre (1 segundos + un poco más)
    setTimeout(() => {
      showNextChar();
    }, 1900);
  });

  // Carrusel y filtrado de proyectos
  document.addEventListener("DOMContentLoaded", () => {
    const filterButtons = document.querySelectorAll(".filter-btn");
    const projectCards = document.querySelectorAll(".project-card");
    const projectsTrack = document.querySelector(
      ".projects-track",
    ) as HTMLElement;

    if (!filterButtons.length || !projectCards.length || !projectsTrack) return;

    let currentIndex = 0;
    let visibleCards: HTMLElement[] = [];

    // Función para obtener las tarjetas visibles según el filtro
    const getVisibleCards = (category: string): HTMLElement[] => {
      return Array.from(projectCards)
        .filter((card) => {
          const cardCategory = card.getAttribute("data-category");
          return category === "all" || cardCategory === category;
        })
        .map((card) => card as HTMLElement);
    };

    // Variables para el arrastre
    let isDragging = false;
    let startX = 0;
    let currentTranslate = 0;
    let prevTranslate = 0;
    let animationID = 0;

    // Función para actualizar el carrusel
    const updateCarousel = (useTransition = true) => {
      if (visibleCards.length === 0) return;

      // Asegurar que el índice esté dentro del rango
      if (currentIndex >= visibleCards.length) {
        currentIndex = visibleCards.length - 1;
      }
      if (currentIndex < 0) {
        currentIndex = 0;
      }

      // Calcular el ancho de la tarjeta y el gap
      const cardWidth = visibleCards[0]?.offsetWidth || 320;
      const gap = window.innerWidth <= 640 ? 24 : 32; // 1.5rem o 2rem
      const translateX = -(currentIndex * (cardWidth + gap)) + currentTranslate;

      if (useTransition) {
        projectsTrack.style.transition = "transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)";
      } else {
        projectsTrack.style.transition = "none";
      }
      projectsTrack.style.transform = `translateX(${translateX}px)`;

      // Aplicar efecto de tarjetas de naipes según la posición
      visibleCards.forEach((card, index) => {
        const distance = Math.abs(index - currentIndex);
        
        if (distance === 0) {
          // Tarjeta activa - escala completa y opacidad total
          card.style.opacity = "1";
          card.style.transform = "scale(1)";
          card.style.zIndex = "10";
        } else if (distance === 1) {
          // Tarjetas adyacentes - ligeramente reducidas
          card.style.opacity = "0.8";
          card.style.transform = "scale(0.95)";
          card.style.zIndex = "5";
        } else {
          // Tarjetas más lejanas - más reducidas
          card.style.opacity = "0.6";
          card.style.transform = "scale(0.9)";
          card.style.zIndex = "1";
        }
      });
    };

    // Función para obtener la posición del evento
    const getPositionX = (event: MouseEvent | TouchEvent): number => {
      return event.type.includes("mouse") 
        ? (event as MouseEvent).clientX 
        : (event as TouchEvent).touches[0].clientX;
    };

    // Función para iniciar el arrastre
    const startDrag = (event: MouseEvent | TouchEvent) => {
      startX = getPositionX(event);
      isDragging = true;
      prevTranslate = currentTranslate;
      
      const carouselContainer = document.querySelector(
        ".projects-carousel-container"
      ) as HTMLElement;
      if (carouselContainer) {
        carouselContainer.style.cursor = "grabbing";
      }
      cancelAnimationFrame(animationID);
    };

    // Función para mover durante el arrastre
    const drag = (event: MouseEvent | TouchEvent) => {
      if (!isDragging) return;
      
      event.preventDefault();
      const currentPosition = getPositionX(event);
      currentTranslate = prevTranslate + currentPosition - startX;
      
      updateCarousel(false);
    };

    // Función para finalizar el arrastre
    const endDrag = () => {
      if (!isDragging) return;
      
      isDragging = false;
      const carouselContainer = document.querySelector(
        ".projects-carousel-container"
      ) as HTMLElement;
      if (carouselContainer) {
        carouselContainer.style.cursor = "grab";
      }
      
      const cardWidth = visibleCards[0]?.offsetWidth || 320;
      const gap = window.innerWidth <= 640 ? 24 : 32;
      const cardWidthWithGap = cardWidth + gap;
      
      // Determinar si debe moverse a la siguiente/anterior tarjeta
      const movedBy = currentTranslate;
      const threshold = cardWidthWithGap * 0.3; // 30% del ancho de la tarjeta
      
      if (Math.abs(movedBy) > threshold) {
        if (movedBy > 0 && currentIndex > 0) {
          currentIndex--;
        } else if (movedBy < 0 && currentIndex < visibleCards.length - 1) {
          currentIndex++;
        }
      }
      
      // Resetear el desplazamiento y actualizar
      currentTranslate = 0;
      prevTranslate = 0;
      updateCarousel(true);
    };

    // Función para agregar event listeners de arrastre al contenedor
    const addDragListeners = () => {
      const carouselContainer = document.querySelector(
        ".projects-carousel-container"
      ) as HTMLElement;
      
      if (!carouselContainer) return;

      // Remover listeners anteriores si existen
      const existingStart = (carouselContainer as any).__dragStart;
      const existingDrag = (carouselContainer as any).__dragMove;
      const existingEnd = (carouselContainer as any).__dragEnd;
      
      if (existingStart) {
        carouselContainer.removeEventListener("mousedown", existingStart);
        carouselContainer.removeEventListener("touchstart", existingStart);
      }
      if (existingDrag) {
        carouselContainer.removeEventListener("mousemove", existingDrag);
        carouselContainer.removeEventListener("touchmove", existingDrag);
      }
      if (existingEnd) {
        carouselContainer.removeEventListener("mouseup", existingEnd);
        carouselContainer.removeEventListener("mouseleave", existingEnd);
        carouselContainer.removeEventListener("touchend", existingEnd);
      }

      // Mouse events
      carouselContainer.addEventListener("mousedown", startDrag);
      carouselContainer.addEventListener("mousemove", drag);
      carouselContainer.addEventListener("mouseup", endDrag);
      carouselContainer.addEventListener("mouseleave", endDrag);
      
      // Touch events para móviles
      carouselContainer.addEventListener("touchstart", startDrag, { passive: false });
      carouselContainer.addEventListener("touchmove", drag, { passive: false });
      carouselContainer.addEventListener("touchend", endDrag);
      
      // Guardar referencias
      (carouselContainer as any).__dragStart = startDrag;
      (carouselContainer as any).__dragMove = drag;
      (carouselContainer as any).__dragEnd = endDrag;
      
      // Cursor grab
      carouselContainer.style.cursor = "grab";
    };

    // Función para reorganizar tarjetas según el filtro
    const reorganizeCards = (category: string) => {
      visibleCards = getVisibleCards(category);

      // Reorganizar visualmente las tarjetas en el DOM
      projectCards.forEach((card) => {
        const cardElement = card as HTMLElement;
        const cardCategory = card.getAttribute("data-category");
        const shouldShow = category === "all" || cardCategory === category;

        if (shouldShow) {
          cardElement.style.display = "block";
          cardElement.style.opacity = "1";
          cardElement.style.transform = "translateX(0) scale(1)";
        } else {
          cardElement.style.display = "none";
        }
      });

      // Reorganizar el orden en el DOM para que las visibles estén primero
      visibleCards.forEach((card, index) => {
        projectsTrack.appendChild(card);
        card.style.order = index.toString();
      });

      // Resetear índice y actualizar carrusel después de que el DOM se actualice
      currentIndex = 0;
      
      // Esperar a que el navegador recalcule los tamaños
      requestAnimationFrame(() => {
        setTimeout(() => {
          // Resetear variables de arrastre
          currentTranslate = 0;
          prevTranslate = 0;
          isDragging = false;
          
          updateCarousel();
          // Actualizar visibleCards y agregar listeners
          visibleCards = getVisibleCards(category);
          addDragListeners();
        }, 100);
      });
    };

    // Event listeners para filtros
    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.getAttribute("data-category") || "all";

        // Actualizar botones activos
        filterButtons.forEach((btn) => btn.classList.remove("active"));
        button.classList.add("active");

        // Reorganizar tarjetas
        reorganizeCards(category);
      });
    });

    // Inicializar con "Todos los proyectos"
    reorganizeCards("all");
    
    // Agregar listeners iniciales
    addDragListeners();
  });

  // Efecto de iluminación suave en scroll para palabras destacadas
  document.addEventListener("DOMContentLoaded", () => {
    const textSection = document.querySelector(
      ".text-section-design",
    ) as HTMLElement;
    const highlightWords = document.querySelectorAll(
      ".highlight-word",
    ) as NodeListOf<HTMLElement>;

    if (!textSection || !highlightWords.length) return;

    const words = Array.from(highlightWords);
    const wordOrder = ["lógica", "sensibilidad", "estructura"];
    
    // Ordenar las palabras según el orden especificado
    const orderedWords = wordOrder.map((word) =>
      words.find((w) => w.getAttribute("data-word") === word),
    ).filter(Boolean) as HTMLElement[];

    // Función para calcular el progreso del scroll
    const updateHighlight = () => {
      const rect = textSection.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Calcular cuando la sección está visible
      const sectionTop = rect.top;
      const sectionBottom = rect.bottom;

      // La sección está visible cuando está en la ventana
      if (sectionTop < windowHeight && sectionBottom > 0) {
        // Calcular el progreso del scroll dentro de la sección
        // Empezamos a iluminar cuando la sección entra en el tercio superior de la ventana
        const startPoint = windowHeight * 0.6;
        const endPoint = windowHeight * 0.1;
        const totalRange = startPoint - endPoint;
        
        // Progreso de 0 a 1 a medida que scrolleamos
        const scrollProgress = Math.max(
          0,
          Math.min(1, (startPoint - sectionTop) / totalRange),
        );

        // Iluminar palabras una a una según el progreso
        const wordsCount = orderedWords.length;
        const progressPerWord = 1 / wordsCount;

        orderedWords.forEach((word, index) => {
          const wordStart = index * progressPerWord;
          const wordEnd = (index + 1) * progressPerWord;
          
          // Si el progreso está en el rango de esta palabra
          if (scrollProgress >= wordStart) {
            // Calcular la intensidad de iluminación para esta palabra
            const wordProgress = Math.min(
              1,
              (scrollProgress - wordStart) / progressPerWord,
            );
            
            // Aplicar iluminación suave - sin animación llamativa
            // La intensidad va de 0 a 1 suavemente
            const intensity = wordProgress;
            const glowIntensity = intensity * 15; // Brillo máximo de 15px
            const glowOpacity = intensity * 0.5; // Opacidad máxima de 0.5
            
            // Color que va del blanco al color primario suavemente
            const colorMix = intensity;
            const r = Math.round(255 * (1 - colorMix) + 43 * colorMix);
            const g = Math.round(255 * (1 - colorMix) + 228 * colorMix);
            const b = Math.round(255 * (1 - colorMix) + 194 * colorMix);
            
            word.style.textShadow = `0 0 ${glowIntensity}px rgba(43, 228, 194, ${glowOpacity})`;
            word.style.color = `rgb(${r}, ${g}, ${b})`;
            word.classList.add("highlighted");
          } else {
            // Restablecer estado inicial
            word.style.textShadow = "none";
            word.style.color = "";
            word.classList.remove("highlighted");
          }
        });
      } else {
        // Si la sección no está visible, resetear
        orderedWords.forEach((word) => {
          word.style.textShadow = "none";
          word.style.color = "";
          word.classList.remove("highlighted");
        });
      }
    };

    // Throttle para mejorar rendimiento
    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateHighlight();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener("scroll", onScroll);
    // Ejecutar una vez al cargar
    updateHighlight();
  });

  // Interacción hover para cambiar frase en título "Diseño para que"
  document.addEventListener("DOMContentLoaded", () => {
    const dynamicText = document.querySelector(
      ".title-part-dynamic",
    ) as HTMLElement;
    const titleSection = document.querySelector(
      ".text-section-title-work",
    ) as HTMLElement;

    if (!dynamicText || !titleSection) return;

    const phrases = [
      "FUNCIONE",
      "se entienda",
      "no frustre",
      "fluya",
    ];

    let currentPhraseIndex = 0;
    let isChanging = false;

    const changePhrase = () => {
      if (isChanging) return;
      
      isChanging = true;
      // Avanzar a la siguiente frase
      currentPhraseIndex = (currentPhraseIndex + 1) % phrases.length;
      dynamicText.style.opacity = "0";
      
      setTimeout(() => {
        dynamicText.textContent = phrases[currentPhraseIndex];
        dynamicText.style.opacity = "1";
        isChanging = false;
      }, 150);
    };

    // Hover solo en el título - cambia a la siguiente frase
    titleSection.addEventListener("mouseenter", () => {
      changePhrase();
    });
  });

  // Sección del proceso interactivo - Movimiento de Pixelhada
  document.addEventListener("DOMContentLoaded", () => {
    const processStart = document.getElementById("process-start") as HTMLElement;
    const processPath = document.getElementById("process-path") as HTMLElement;
    const btnStart = document.getElementById("btn-start-process") as HTMLButtonElement;
    const pathCells = document.querySelector(".path-cells") as HTMLElement;
    const pixelhadaWrapper = document.getElementById("pixelhada-wrapper") as HTMLElement;
    const btnBack = document.getElementById("btn-back") as HTMLButtonElement;
    const btnForward = document.getElementById("btn-forward") as HTMLButtonElement;
    const floatingMessages = pixelhadaWrapper.querySelectorAll(".floating-message") as NodeListOf<HTMLElement>;

    if (!processStart || !processPath || !btnStart || !pathCells || !pixelhadaWrapper || !btnBack || !btnForward) return;

    // Posiciones objetivo donde Pixelhada puede estar (celdas 3, 6, 9)
    const targetCells = [3, 6, 9];
    let currentPosition = 0; // Índice en targetCells (0 = celda 3, 1 = celda 6, 2 = celda 9)

    // Función para obtener una celda por su índice
    const getCellByIndex = (index: number): HTMLElement | null => {
      return pathCells.querySelector(`[data-cell-index="${index}"]`) as HTMLElement | null;
    };

    // Función para mostrar/ocultar el mensaje flotante
    const updateFloatingMessage = (cellIndex: number) => {
      if (!pixelhadaWrapper) return;
      
      // Obtener todos los mensajes flotantes (actualizar en cada llamada por si acaso)
      const allMessages = pixelhadaWrapper.querySelectorAll(".floating-message") as NodeListOf<HTMLElement>;
      
      // Ocultar todos los mensajes primero
      allMessages.forEach((message) => {
        if (message) {
          const messageCell = message.getAttribute("data-cell");
          if (messageCell === "3" || messageCell === "9") {
            // Para los mensajes de las celdas 3 y 9, usar display: none para que no ocupen espacio
            message.style.display = "none";
            message.style.opacity = "0";
          } else {
            // Para otros mensajes, usar opacity
            message.style.opacity = "0";
          }
        }
      });
      
      // Mostrar el mensaje correspondiente a la celda actual (celdas 3, 6 y 9)
      if (cellIndex === 3 || cellIndex === 6 || cellIndex === 9) {
        const targetMessage = pixelhadaWrapper.querySelector(`.floating-message[data-cell="${cellIndex}"]`) as HTMLElement;
        if (targetMessage) {
          if (cellIndex === 3 || cellIndex === 9) {
            targetMessage.style.display = "block";
            targetMessage.style.opacity = "1";
          } else {
            targetMessage.style.opacity = "1";
          }
        }
      }
    };

    // Función para mover Pixelhada a una celda específica
    const movePixelhadaToCell = (cellIndex: number) => {
      const cell = getCellByIndex(cellIndex);
      if (!cell || !pixelhadaWrapper) return;

      const pixelhadaImage = pixelhadaWrapper.querySelector("img") as HTMLImageElement;
      if (!pixelhadaImage) return;

      const cellRect = cell.getBoundingClientRect();
      const containerRect = (pathCells.parentElement as HTMLElement).getBoundingClientRect();
      
      // Obtener dimensiones reales de la imagen (considerando el tamaño renderizado)
      const imageWidth = pixelhadaImage.offsetWidth || 120; // Ancho por defecto si no está cargado
      const imageHeight = pixelhadaImage.offsetHeight || 120; // Altura por defecto si no está cargado
      
      // Calcular posición: centrada horizontalmente, pies en la parte inferior de la celda
      // left: centro de la celda menos la mitad del ancho de la imagen
      const left = cellRect.left - containerRect.left + (cellRect.width / 2) - (imageWidth / 2);
      
      // top: parte inferior de la celda menos la altura completa de la imagen (para que los pies toquen el borde)
      const top = cellRect.top - containerRect.top + cellRect.height - imageHeight;
      
      pixelhadaWrapper.style.transform = `translate(${left}px, ${top}px)`;
      pixelhadaWrapper.style.opacity = "1";
      
      // Actualizar posición del mensaje flotante
      updateFloatingMessage(cellIndex);
    };

    // Función para actualizar el resaltado de la celda activa
    const updateActiveCell = (cellIndex: number) => {
      // Remover clase activa de todas las celdas
      const allCells = pathCells.querySelectorAll(".path-cell");
      allCells.forEach((cell) => {
        cell.classList.remove("active-cell");
      });

      // Agregar clase activa a la celda actual
      const activeCell = getCellByIndex(cellIndex);
      if (activeCell) {
        activeCell.classList.add("active-cell");
      }
    };

    // Función para volver a la vista inicial
    const returnToStart = () => {
      // Ocultar el camino iterativo
      processPath.style.display = "none";
      
      // Mostrar la vista inicial
      processStart.style.display = "flex";
      
      // Resetear la posición actual
      currentPosition = 0;
    };

    // Función para actualizar el estado de los botones
    const updateButtons = () => {
      // El botón Volver siempre está habilitado (puede volver al inicio desde celda 3)
      btnBack.disabled = false;
      btnBack.style.opacity = "1";
      btnBack.style.cursor = "pointer";

      // Si estamos en la última posición (celda 8), deshabilitar botón Avanzar
      btnForward.disabled = currentPosition === targetCells.length - 1;
      if (currentPosition === targetCells.length - 1) {
        btnForward.style.opacity = "0.5";
        btnForward.style.cursor = "not-allowed";
      } else {
        btnForward.style.opacity = "1";
        btnForward.style.cursor = "pointer";
      }
    };

    // Función para mover a la siguiente posición con iluminación progresiva
    const moveForward = () => {
      if (currentPosition < targetCells.length - 1) {
        const fromCell = targetCells[currentPosition];
        const nextPosition = currentPosition + 1;
        const toCell = targetCells[nextPosition];
        
        // Iluminar celdas progresivamente desde la actual hasta la siguiente
        illuminateCellsProgressively(fromCell, toCell, () => {
          currentPosition = nextPosition;
          movePixelhadaToCell(toCell);
          updateButtons();
        });
      }
    };

    // Función para mover a la posición anterior con desiluminación progresiva
    const moveBack = () => {
      if (currentPosition > 0) {
        const fromCell = targetCells[currentPosition];
        const prevPosition = currentPosition - 1;
        const toCell = targetCells[prevPosition];
        
        // Desiluminar celdas progresivamente desde la actual hasta la anterior
        deilluminateCellsProgressively(fromCell, toCell, () => {
          currentPosition = prevPosition;
          movePixelhadaToCell(toCell);
          updateButtons();
        });
      } else {
        // Si estamos en la primera posición (celda 3), volver al inicio
        returnToStart();
      }
    };

    // Control de scroll del mouse - solo cuando el cursor está sobre el contenedor de celdas
    let scrollTimeout: ReturnType<typeof setTimeout> | null = null;
    let isScrolling = false;
    let isMouseOverCells = false;

    // Detectar cuando el mouse entra o sale del contenedor de celdas
    pathCells.addEventListener("mouseenter", () => {
      isMouseOverCells = true;
    });

    pathCells.addEventListener("mouseleave", () => {
      isMouseOverCells = false;
    });

    const handleWheel = (e: WheelEvent) => {
      // Solo procesar si el cursor está sobre el contenedor de celdas
      if (!isMouseOverCells) return;

      // Verificar que el cursor esté realmente sobre el contenedor
      const cellsRect = pathCells.getBoundingClientRect();
      const isInCells = 
        e.clientY >= cellsRect.top && 
        e.clientY <= cellsRect.bottom &&
        e.clientX >= cellsRect.left && 
        e.clientX <= cellsRect.right;

      if (!isInCells) return;

      // Prevenir scroll si estamos en el contenedor de celdas
      e.preventDefault();

      // Throttle para evitar múltiples eventos
      if (isScrolling) return;

      isScrolling = true;
      
      if (e.deltaY > 0) {
        // Scroll hacia abajo = avanzar
        moveForward();
      } else if (e.deltaY < 0) {
        // Scroll hacia arriba = retroceder (o volver al inicio si está en la primera posición)
        moveBack();
      }

      // Resetear flag después de un delay
      if (scrollTimeout) clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        isScrolling = false;
      }, 500);
    };

    // Función para iluminar celdas progresivamente (hacia adelante)
    const illuminateCellsProgressively = (fromCell: number, toCell: number, callback: () => void) => {
      // Determinar las celdas que deben iluminarse en orden
      const cellsToIlluminate: number[] = [];
      for (let i = fromCell; i <= toCell; i++) {
        cellsToIlluminate.push(i);
      }

      let currentCellIndex = 0;

      const illuminateNext = () => {
        if (currentCellIndex < cellsToIlluminate.length) {
          const cellIndex = cellsToIlluminate[currentCellIndex];
          const cell = getCellByIndex(cellIndex);
          
          if (cell) {
            // Agregar clase activa para iluminar
            cell.classList.add("active-cell");
            
            // Si es la última celda, ejecutar callback
            if (currentCellIndex === cellsToIlluminate.length - 1) {
              setTimeout(() => {
                callback();
              }, 200); // Pequeña pausa antes de mover Pixelhada
            } else {
              // Continuar con la siguiente celda
              currentCellIndex++;
              setTimeout(illuminateNext, 400); // Delay de 400ms entre cada iluminación
            }
          }
        }
      };

      // Iniciar la iluminación progresiva
      illuminateNext();
    };

    // Función para desiluminar celdas progresivamente (hacia atrás)
    const deilluminateCellsProgressively = (fromCell: number, toCell: number, callback: () => void) => {
      // Determinar las celdas que deben desiluminarse en orden (de mayor a menor)
      const cellsToDeilluminate: number[] = [];
      for (let i = fromCell; i >= toCell; i--) {
        cellsToDeilluminate.push(i);
      }

      let currentCellIndex = 0;

      const deilluminateNext = () => {
        if (currentCellIndex < cellsToDeilluminate.length) {
          const cellIndex = cellsToDeilluminate[currentCellIndex];
          const cell = getCellByIndex(cellIndex);
          
          if (cell) {
            // Remover clase activa para desiluminar
            cell.classList.remove("active-cell");
            
            // Si es la última celda, ejecutar callback
            if (currentCellIndex === cellsToDeilluminate.length - 1) {
              setTimeout(() => {
                callback();
              }, 200); // Pequeña pausa antes de mover Pixelhada
            } else {
              // Continuar con la siguiente celda
              currentCellIndex++;
              setTimeout(deilluminateNext, 400); // Delay de 400ms entre cada desiluminación
            }
          }
        }
      };

      // Iniciar la desiluminación progresiva
      deilluminateNext();
    };

    // Función para inicializar Pixelhada con animación
    const initPixelhadaWithAnimation = () => {
      const pixelhadaImage = pixelhadaWrapper.querySelector("img") as HTMLImageElement;
      
      // Limpiar todas las clases activas antes de empezar
      const allCells = pathCells.querySelectorAll(".path-cell");
      allCells.forEach((cell) => {
        cell.classList.remove("active-cell");
      });
      
      // Función para mover Pixelhada después de la iluminación inicial
      const movePixelhadaAfterIllumination = () => {
        const initialCellIndex = targetCells[currentPosition]; // celda 3
        
        // Mover Pixelhada a la celda 3 con transición suave
        movePixelhadaToCell(initialCellIndex);
        updateFloatingMessage(initialCellIndex);
        updateButtons();
      };

      // Si la imagen ya está cargada, iniciar animación
      if (pixelhadaImage && pixelhadaImage.complete) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            // Iluminar celdas progresivamente desde la 1 hasta la 3 y luego mover Pixelhada
            illuminateCellsProgressively(1, 3, movePixelhadaAfterIllumination);
          });
        });
      } else {
        // Esperar a que la imagen se cargue
        if (pixelhadaImage) {
          pixelhadaImage.addEventListener("load", () => {
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                // Iluminar celdas progresivamente desde la 1 hasta la 3 y luego mover Pixelhada
                illuminateCellsProgressively(1, 3, movePixelhadaAfterIllumination);
              });
            });
          }, { once: true });
        }
      }
    };

    // Event listener para el botón "Vamos"
    btnStart.addEventListener("click", () => {
      // Ocultar Pixelhada inicialmente
      if (pixelhadaWrapper) {
        pixelhadaWrapper.style.opacity = "0";
      }
      
      // Micro pausa antes de iniciar (0.2-0.3s)
      setTimeout(() => {
        // Ocultar la vista inicial
        processStart.style.display = "none";
        
        // Mostrar el camino iterativo
        processPath.style.display = "flex";
        
        // Inicializar Pixelhada con animación después de que el camino sea visible
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            initPixelhadaWithAnimation();
          });
        });
      }, 250);
    });

    // Event listeners para los botones de navegación
    btnForward.addEventListener("click", moveForward);
    btnBack.addEventListener("click", moveBack);

    // Event listener para el scroll del mouse
    window.addEventListener("wheel", handleWheel, { passive: false });

    // Función genérica para configurar hover de una celda
    const setupCellHover = (cellIndex: number) => {
      const cell = getCellByIndex(cellIndex);
      const floatingMessage = pixelhadaWrapper.querySelector(`.floating-message-hover[data-cell="${cellIndex}"]`) as HTMLElement;
      
      if (!cell || !floatingMessage) {
        return;
      }

      // Calcular posición del mensaje sobre la celda
      const updateMessagePosition = () => {
        const cellRect = cell.getBoundingClientRect();
        const wrapperRect = pixelhadaWrapper.getBoundingClientRect();
        
        // Posicionar el mensaje centrado sobre la celda, más cerca para que parezca que sale de la celda
        const cellCenterX = cellRect.left + (cellRect.width / 2);
        const left = cellCenterX - wrapperRect.left;
        const top = cellRect.top - wrapperRect.top - 50; // 50px arriba de la celda (más cerca)
        
        floatingMessage.style.left = `${left}px`;
        floatingMessage.style.top = `${top}px`;
      };

      // Mostrar mensaje en hover con animación de emergencia
      cell.addEventListener("mouseenter", () => {
        updateMessagePosition();
        floatingMessage.classList.add("show");
      });

      // Ocultar mensaje al salir del hover
      cell.addEventListener("mouseleave", () => {
        floatingMessage.classList.remove("show");
      });

      // Recalcular posición en resize
      window.addEventListener("resize", () => {
        if (floatingMessage.classList.contains("show")) {
          updateMessagePosition();
        }
      });
    };

    // Inicializar el hover de todas las celdas con mensajes (1, 2, 4, 5, 7, 8)
    const setupAllCellHovers = () => {
      const cellsWithHover = [1, 2, 4, 5, 7, 8];
      cellsWithHover.forEach(cellIndex => {
        setupCellHover(cellIndex);
      });
    };

    // Inicializar los hovers después de que el camino sea visible
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        setupAllCellHovers();
      });
    });

    // Recalcular posición en resize para mantener Pixelhada y mensaje flotante en su lugar
    let resizeTimeout: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        const currentCellIndex = targetCells[currentPosition];
        movePixelhadaToCell(currentCellIndex);
        updateFloatingMessage(currentCellIndex);
      }, 250);
    });
  });
</script>

