---
import '../../styles/global.css';
import StarField from '../../components/StarField.astro';
import TalentCard from '../../components/TalentCard.astro';

import genesisData from '../../data/genesis-duran.json';
import developersData from '../../data/developers.json';

const genesis = Array.isArray(genesisData) ? genesisData[0] : genesisData;

interface Developer {
  slug: string;
  nombre: string;
  apellido: string;
  roles?: string[];
  bio: string;
  foto?: string;
}

const developers = developersData as Developer[];
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Talento | Pixelhada</title>
    <link rel="icon" type="image/png" href="/images/logo-.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aboreto&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <nav class="navbar">
      <div class="navbar-container">
        <a href="/" class="navbar-logo">
          <span class="logo-mark">&#10022;</span>
          <span class="logo-text">Pixelhada</span>
        </a>

        <button class="navbar-toggle" aria-label="Abrir menú" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <ul class="navbar-menu">
          <li>
            <a href="/" class="nav-link">
              <span>Inicio</span>
            </a>
          </li>
          <li>
            <a href="/talento" class="nav-link active">
              <span>Talento</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="page-wrapper">
      <main class="talent-page">
        <!-- Header -->
        <section class="talent-header">
          <StarField count={35} />
          <div class="talent-header-content">
            <h1 class="talent-title">Nuestros Creadores de Magia</h1>
            <p class="talent-subtitle">
              Detrás de cada pixel hay pasión, detrás de cada línea de código hay propósito.
              Conoce a quienes dan vida a Pixelhada.
            </p>
          </div>
          <div class="talent-header-orb" aria-hidden="true"></div>
        </section>

        <!-- Sección destacada: Génesis -->
        <section class="talent-featured">
          <div class="talent-container">
            <h2 class="talent-section-label animate-on-scroll">Diseño</h2>
            <TalentCard
              name={`${genesis.nombre} ${genesis.apellido}`}
              role="Diseñadora UX/UI & Creativa Visual"
              description={genesis.bio.replace('[BR]', ' ')}
              href="/talento/genesis-duran"
              image={genesis.foto}
              featured={true}
            />
          </div>
        </section>

        <!-- Grid dinámico -->
        <section class="talent-grid-section">
          <div class="talent-container">
            <h2 class="talent-section-label animate-on-scroll">Desarrollo</h2>
            <div class="talent-grid">
              {developers.map((dev) => (
                <TalentCard
                  name={`${dev.nombre} ${dev.apellido}`}
                  role={dev.roles ? dev.roles.join(' · ') : 'Desarrollador'}
                  description={dev.bio}
                  href={`/talento/${dev.slug}`}
                  image={dev.foto}
                />
              ))}
            </div>
          </div>
        </section>

        <!-- CTA de vuelta -->
        <section class="talent-back">
          <a href="/" class="talent-back-link">&larr; Volver al inicio</a>
        </section>
      </main>
    </div>

    <footer class="footer">
      <div class="footer-content">
        <a href="/" class="footer-brand-link">
          <img src="/images/pixel-hada.png" alt="Pixelhada" class="footer-brand-logo" width="28" height="28" />
          <span class="footer-brand-mark">&#10022;</span>
          <span class="footer-brand-name">Pixelhada</span>
        </a>
        <nav class="footer-nav-links" aria-label="Navegación Pixelhada">
          <a href="/" class="footer-nav-item">Inicio</a>
          <span class="footer-nav-sep" aria-hidden="true">&#183;</span>
          <a href="/talento" class="footer-nav-item">Talento</a>
        </nav>
        <p class="footer-copy">&copy; 2026 Pixelhada. Todos los derechos reservados.</p>
      </div>
    </footer>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.querySelector('.navbar-toggle') as HTMLButtonElement;
        const menu = document.querySelector('.navbar-menu') as HTMLElement;
        
        if (toggle && menu) {
          toggle.addEventListener('click', () => {
            const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!isExpanded));
            menu.setAttribute('data-visible', String(!isExpanded));
          });

          const navLinks = menu.querySelectorAll('.nav-link');
          navLinks.forEach(link => {
            link.addEventListener('click', () => {
              toggle.setAttribute('aria-expanded', 'false');
              menu.setAttribute('data-visible', 'false');
            });
          });

          document.addEventListener('click', (e) => {
            if (!menu.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
              toggle.setAttribute('aria-expanded', 'false');
              menu.setAttribute('data-visible', 'false');
            }
          });
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.animate-on-scroll').forEach((el) => {
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>

<style>
  .talent-page {
    padding-top: 80px;
  }

  .talent-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Header */
  .talent-header {
    position: relative;
    padding: 6rem 2rem 4rem;
    text-align: center;
    overflow: hidden;
  }

  .talent-header-content {
    position: relative;
    z-index: 1;
    max-width: 650px;
    margin: 0 auto;
    animation: fadeInUp 1s ease-out;
  }

  .talent-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1.25rem;
    background: linear-gradient(135deg, var(--color-text-white) 0%, var(--color-lavender) 60%, var(--color-soft-pink) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }

  .talent-subtitle {
    font-size: 1.05rem;
    line-height: 1.7;
    opacity: 0.7;
    margin: 0;
  }

  .talent-header-orb {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(196, 181, 224, 0.12) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: blur(60px);
    pointer-events: none;
  }

  /* Labels */
  .talent-section-label {
    font-size: 0.85rem;
    font-family: var(--font-paragraph);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--color-lavender);
    opacity: 0.6;
    margin: 0 0 1.5rem;
    text-align: center;
  }

  /* Featured */
  .talent-featured {
    padding: 2rem 0 3rem;
  }

  /* Grid */
  .talent-grid-section {
    padding: 2rem 0 4rem;
  }

  .talent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .talent-grid:has(> :only-child) {
    grid-template-columns: 1fr;
  }

  .talent-grid > :global(:only-child) {
    flex-direction: row;
    text-align: left;
    gap: 2.5rem;
    padding: 3rem;
    background: linear-gradient(135deg, rgba(47, 46, 62, 0.8), rgba(30, 30, 30, 0.6));
    border: 1px solid rgba(196, 181, 224, 0.15);
    position: relative;
  }

  .talent-grid > :global(:only-child::before) {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    padding: 1px;
    background: linear-gradient(135deg, var(--color-lavender), var(--color-periwinkle), var(--color-soft-pink));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.4;
    transition: opacity 0.4s ease;
  }

  .talent-grid > :global(:only-child:hover::before) {
    opacity: 0.8;
  }

  .talent-grid > :global(:only-child .talent-card-image) {
    width: 140px;
    height: 140px;
    margin-bottom: 0;
  }

  .talent-grid > :global(:only-child .talent-card-info) {
    align-items: flex-start;
  }

  .talent-grid > :global(:only-child .talent-card-name) {
    font-size: 1.6rem;
  }

  .talent-grid > :global(:only-child .talent-card-desc) {
    font-size: 0.95rem;
    max-width: 500px;
  }

  @media (max-width: 768px) {
    .talent-grid > :global(:only-child) {
      flex-direction: column;
      text-align: center;
      padding: 2.5rem 2rem;
      gap: 1.5rem;
    }

    .talent-grid > :global(:only-child .talent-card-info) {
      align-items: center;
    }

    .talent-grid > :global(:only-child .talent-card-image) {
      width: 120px;
      height: 120px;
    }

    .talent-grid > :global(:only-child .talent-card-desc) {
      max-width: none;
    }
  }

  /* Back */
  .talent-back {
    text-align: center;
    padding: 0 2rem 4rem;
  }

  .talent-back-link {
    font-size: 0.9rem;
    color: var(--color-text-white);
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  .talent-back-link:hover {
    opacity: 1;
    color: var(--color-lavender);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(25px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
