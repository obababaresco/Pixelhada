---
import Layout from '../../layouts/Layout.astro';
import developersData from '../../data/developers.json'; 

// Definimos el tipo para un desarrollador
interface Skill {
  name: string;
  level: number;
}

interface Proyecto {
  title: string;
  description: string;
  tags: string[];
  image: string;
  link: string;
}

interface Educacion {
  titulo: string;
  institucion: string;
  periodo: string;
  descripcion: string;
}

interface Curso {
  titulo: string;
  plataforma: string;
  año: string;
  horas: number;
}

interface Developer {
  slug: string;
  nombre: string;
  apellido: string;
  roles: string[];
  bio: string;
  foto?: string;
  skills: Skill[];
  proyectos: Proyecto[];
  educacion: Educacion[];
  cursos: Curso[];
}

interface Props {
  dev: Developer;
}

export function getStaticPaths() {
  // Convertimos los datos importados al tipo Developer[]
  const developers = developersData as Developer[];

  return developers.map((dev) => ({
    params: { id: dev.slug },
    props: { dev },
  }));
}

const { dev } = Astro.props;

// Extraer todos los tags únicos de los proyectos
const allTags = Array.from(new Set(dev.proyectos.flatMap(p => p.tags)));
---

<Layout title={`Portafolio de ${dev.nombre} ${dev.apellido}`}>
  <div class="portfolio-container">
    <!-- Header Hero Section -->
    <header class="portfolio-hero" id="acerca-de">
      <div class="hero-content">
        <div class="hero-text">
          <h1 class="hero-name">Hola, soy <span class="highlight">{dev.nombre} {dev.apellido}</span></h1>
          <div class="hero-role">
            <span class="typewriter-role" data-roles={JSON.stringify(dev.roles)}></span>
          </div>
          <p class="hero-description">
            {dev.bio}
          </p>
          <div class="hero-buttons">
            <a href="#contacto" class="btn-hire">
              <span>→</span> Contratar
            </a>
            <a href="#" class="btn-cv">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Descargar CV
            </a>
          </div>
          <div class="hero-social">
            <span class="social-label">SÍGUEME</span>
            <div class="social-icons">
              <a href="#" class="social-icon" aria-label="Instagram">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
              <a href="#" class="social-icon" aria-label="LinkedIn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
              <a href="#" class="social-icon" aria-label="GitHub">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
        <div class="hero-image-wrapper">
          {dev.foto ? (
            <div class="image-container">
              <img src={dev.foto} alt={dev.nombre} class="dev-photo" />
            </div>
          ) : (
            <div class="image-placeholder">
              <span>Foto</span>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Skills Section -->
    <section class="skills-section section-bg" id="skills">
      <div class="section-container">
        <h2 class="section-title">Habilidades Técnicas</h2>
        <div class="skills-grid">
          {dev.skills.map((skill) => (
            <div class="skill-card">
              <div class="skill-header">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-percentage">{skill.level}%</span>
              </div>
              <div class="skill-bar">
                <div class="skill-progress" style={`width: ${skill.level}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section class="projects-section" id="proyectos">
      <div class="section-container">
        <h2 class="section-title">Proyectos Realizados</h2>
        <div class="projects-filters">
          <button class="filter-btn selected" data-filter="all">Todos</button>
          {allTags.map((tag) => (
            <button class="filter-btn" data-filter={tag}>{tag}</button>
          ))}
        </div>
        <div class="projects-grid" id="projects-grid">
          {dev.proyectos.map((proyecto) => (
            <article class="project-card" data-tags={JSON.stringify(proyecto.tags)}>
              <div class="project-image-wrapper">
                <img src={proyecto.image} alt={proyecto.title} class="project-image" />
                <div class="project-overlay">
                  <a href={proyecto.link} class="project-link" target="_blank" rel="noopener">
                    Ver Proyecto →
                  </a>
                </div>
              </div>
              <div class="project-content">
                <h3 class="project-title">{proyecto.title}</h3>
                <p class="project-description">{proyecto.description}</p>
                <div class="project-tags">
                  {proyecto.tags.map((tag) => (
                    <span class="project-tag tag">{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Education & Courses Section -->
    <section class="education-section" id="estudios">
      <div class="section-container">
        <div class="education-grid">
          <!-- Education -->
          <div class="education-column">
            <h2 class="section-title">Educación</h2>
            <div class="education-list">
              {dev.educacion.map((edu) => (
                <div class="education-item">
                  <div class="education-header">
                    <h3 class="education-title">{edu.titulo}</h3>
                    <span class="education-period">{edu.periodo}</span>
                  </div>
                  <p class="education-institution">{edu.institucion}</p>
                  <p class="education-description">{edu.descripcion}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Courses -->
          <div class="courses-column">
            <h2 class="section-title">Cursos Realizados</h2>
            <div class="courses-list">
              {dev.cursos.map((curso) => (
                <div class="course-item">
                  <div class="course-header">
                    <h3 class="course-title">{curso.titulo}</h3>
                    <span class="course-year">{curso.año}</span>
                  </div>
                  <div class="course-meta">
                    <span class="course-platform">{curso.plataforma}</span>
                    <span class="course-hours">{curso.horas}h</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Efecto Typewriter para los roles
  document.addEventListener('DOMContentLoaded', () => {
    const typewriterElement = document.querySelector('.typewriter-role') as HTMLElement;
    if (!typewriterElement) return;
    
    const roles = JSON.parse(typewriterElement.getAttribute('data-roles') || '[]');
    if (roles.length === 0) return;
    
    // Calcular el ancho máximo basado en el rol más largo
    const tempSpan = document.createElement('span');
    tempSpan.style.visibility = 'hidden';
    tempSpan.style.position = 'absolute';
    tempSpan.style.fontSize = window.getComputedStyle(typewriterElement).fontSize;
    tempSpan.style.fontFamily = window.getComputedStyle(typewriterElement).fontFamily;
    tempSpan.style.fontWeight = window.getComputedStyle(typewriterElement).fontWeight;
    tempSpan.style.padding = window.getComputedStyle(typewriterElement).padding;
    tempSpan.style.height = window.getComputedStyle(typewriterElement).height;
    tempSpan.style.lineHeight = window.getComputedStyle(typewriterElement).lineHeight;
    document.body.appendChild(tempSpan);
    
    let maxWidth = 0;
    roles.forEach((role: string) => {
      tempSpan.textContent = role;
      const width = tempSpan.offsetWidth;
      if (width > maxWidth) {
        maxWidth = width;
      }
    });
    
    document.body.removeChild(tempSpan);
    
    // Establecer el ancho fijo del contenedor (mantener altura fija)
    const isMobile = window.innerWidth <= 640;
    const fixedHeight = isMobile ? '50px' : '60px';
    
    typewriterElement.style.width = `${maxWidth + 20}px`;
    typewriterElement.style.minWidth = `${maxWidth + 20}px`;
    typewriterElement.style.height = fixedHeight;
    typewriterElement.style.minHeight = fixedHeight;
    
    let currentRoleIndex = 0;
    let currentCharIndex = 0;
    let isDeleting = false;
    let currentText = '';
    let typingSpeed = 100;
    let deletingSpeed = 50;
    let pauseTime = 2000;
    
    function typeWriter() {
      if (!typewriterElement) return;
      
      const currentRole = roles[currentRoleIndex];
      
      if (isDeleting) {
        currentText = currentRole.substring(0, currentCharIndex - 1);
        currentCharIndex--;
        typingSpeed = deletingSpeed;
        
        if (currentText === '') {
          isDeleting = false;
          currentRoleIndex = (currentRoleIndex + 1) % roles.length;
          typingSpeed = 500; // Pausa antes de escribir el siguiente
        }
      } else {
        currentText = currentRole.substring(0, currentCharIndex + 1);
        currentCharIndex++;
        typingSpeed = 100;
        
        if (currentText === currentRole) {
          typingSpeed = pauseTime;
          isDeleting = true;
        }
      }
      
      typewriterElement.textContent = currentText;
      setTimeout(typeWriter, typingSpeed);
    }
    
    setTimeout(typeWriter, 1000);
  });

  // Filtros de proyectos
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');
    
    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Actualizar botones activos
        filterButtons.forEach(btn => btn.classList.remove('selected'));
        button.classList.add('selected');
        
        const filter = button.getAttribute('data-filter');
        
        projectCards.forEach(card => {
          const cardElement = card as HTMLElement;
          if (filter === 'all') {
            cardElement.style.display = 'block';
            setTimeout(() => {
              cardElement.style.opacity = '1';
              cardElement.style.transform = 'translateY(0)';
            }, 10);
          } else {
            const tags = JSON.parse(card.getAttribute('data-tags') || '[]');
            if (tags.includes(filter)) {
              cardElement.style.display = 'block';
              setTimeout(() => {
                cardElement.style.opacity = '1';
                cardElement.style.transform = 'translateY(0)';
              }, 10);
            } else {
              cardElement.style.opacity = '0';
              cardElement.style.transform = 'translateY(20px)';
              setTimeout(() => {
                cardElement.style.display = 'none';
              }, 300);
            }
          }
        });
      });
    });
  });

  // Scroll Spy para el menú
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section[id], header[id]');
    const navLinks = document.querySelectorAll('.nav-link');
    const offset = 100; // Debe coincidir con scroll-padding-top

    function updateActiveLink() {
      let currentSection = '';
      const scrollPosition = window.scrollY;

      // Si estamos en la parte superior, activar "Acerca de"
      if (scrollPosition < 150) {
        currentSection = 'acerca-de';
      } else {
        // Buscar la sección que está más cerca del offset
        let closestSection = '';
        let closestDistance = Infinity;

        sections.forEach(section => {
          const rect = section.getBoundingClientRect();
          const sectionId = section.getAttribute('id');

          if (sectionId) {
            // Si la sección está en el viewport o ya pasó
            if (rect.top <= offset + 180) {
              const distance = Math.abs(rect.top - offset);
              if (distance < closestDistance) {
                closestDistance = distance;
                closestSection = sectionId;
              }
            }
          }
        });

        currentSection = closestSection || 'acerca-de';
      }

      // Actualizar los enlaces activos
      navLinks.forEach(link => {
        link.classList.remove('active');
        const href = link.getAttribute('href');
        if (href === `#${currentSection}`) {
          link.classList.add('active');
        }
      });
    }

    // Actualizar al cargar la página
    updateActiveLink();

    // Actualizar al hacer scroll
    let ticking = false;
    let scrollTimeout: ReturnType<typeof setTimeout>;
    
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActiveLink();
          ticking = false;
        });
        ticking = true;
      }

      // Actualizar también después de que termine el scroll (útil para scroll suave)
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        updateActiveLink();
      }, 150);
    });

    // Actualizar cuando se hace clic en un enlace (después del scroll suave)
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          // Actualizar después de un delay para que el scroll suave termine
          setTimeout(() => {
            updateActiveLink();
          }, 300);
        }
      });
    });
  });
</script>

<style>
  .portfolio-container {
    padding: 0;
  }

  /* Hero Section */
  .portfolio-hero {
    height: auto;
    display: flex;
    align-items: center;
    padding: 8rem 2rem 6rem;
    position: relative;
    overflow: hidden;
    background: var(--color-bg-main);
    scroll-margin-top: 100px;
  }

  .portfolio-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 50%, rgba(43, 228, 194, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(252, 246, 3, 0.1) 0%, transparent 50%);
    animation: backgroundPulse 8s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes backgroundPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-text {
    animation: slideInLeft 1s ease-out;
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-family: var(--font-heading);
    line-height: 1.2;
    margin-bottom: 1.5rem;
    color: var(--color-text-white);
    font-weight: 700;
  }

  .hero-role {
    margin-bottom: 2rem;
    min-height: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .typewriter-role {
    display: inline-flex;
    align-items: center;
    background: var(--color-bg-sections);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 0.75rem 1.5rem;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text-white);
    text-align: left;
    white-space: nowrap;
    position: relative;
    box-sizing: border-box;
    min-height: 60px;
    height: 60px;
    line-height: 1.2;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .hero-description {
    font-size: 1rem;
    line-height: 1.8;
    opacity: 0.7;
    max-width: 600px;
    margin-bottom: 2.5rem;
    color: var(--color-text-white);
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .btn-hire {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    background-color: #ffffff;
    color: var(--color-text-button-selected);
    border: none;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    font-family: var(--font-button-selected);
  }

  .btn-hire:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 255, 255, 0.2);
  }

  .btn-hire span {
    font-size: 1.2rem;
  }

  .btn-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    background: var(--color-bg-main);
    color: var(--color-text-white);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    font-family: var(--font-button-selected);
  }

  .btn-cv:hover {
    background: var(--color-bg-sections);
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .btn-cv svg {
    width: 16px;
    height: 16px;
  }

  .hero-social {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .social-label {
    font-size: 0.75rem;
    color: var(--color-text-white);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    font-family: var(--font-paragraph);
    text-align: left;
  }

  .social-icons {
    display: flex;
    gap: 1rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-bg-sections);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-white);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .social-icon:hover {
    background: var(--color-primary);
    color: var(--color-text-button-selected);
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(43, 228, 194, 0.3);
  }

  .social-icon svg {
    width: 20px;
    height: 20px;
  }

  .hero-image-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: slideInRight 1s ease-out;
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .image-container {
    position: relative;
    width: 100%;
    max-width: 700px;
    overflow: visible;
  }

  .dev-photo {
    width: 100%;
    height: 100%;
    object-fit: fill;
    position: relative;
    display: block;
    z-index: 1;
  }

  /* Section Styles */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-family: var(--font-heading);
    text-align: center;
    margin-bottom: 3rem;
    color: var(--color-text-white);
    position: relative;
    display: inline-block;
    width: 100%;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
  }

  /* Skills Section */
  .skills-section {
    padding: 6rem 0;
    scroll-margin-top: 100px;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .skill-card {
    background: var(--color-bg-main);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .skill-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-primary);
    box-shadow: 0 10px 30px rgba(43, 228, 194, 0.2);
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .skill-name {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-text-white);
  }

  .skill-percentage {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.9rem;
  }

  .skill-bar {
    width: 100%;
    height: 8px;
    background: var(--color-bg-sections);
    border-radius: 4px;
    overflow: hidden;
  }

  .skill-progress {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary), var(--color-emphasis));
    border-radius: 4px;
    transition: width 1s ease-out;
    animation: progressGlow 2s ease-in-out infinite;
  }

  @keyframes progressGlow {
    0%, 100% { box-shadow: 0 0 5px var(--color-primary); }
    50% { box-shadow: 0 0 15px var(--color-primary); }
  }

  /* Projects Section */
  .projects-section {
    padding: 6rem 0;
    scroll-margin-top: 100px;
  }

  .projects-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .filter-btn {
    padding: 0.75rem 1.5rem;
    background: var(--color-button-normal-bg);
    color: var(--color-text-white);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 25px;
    font-family: var(--font-tag);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
