---
import '../styles/global.css';
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Pixelhada</title>
    <link rel="icon" type="image/png" href="/images/logo-.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aboreto&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <nav class="navbar navbar-home">
      <div class="navbar-container">
        <a href="/" class="navbar-logo">
          <span class="logo-mark">&#10022;</span>
          <span class="logo-text">Pixelhada</span>
        </a>

        <button class="navbar-toggle" aria-label="Abrir menú" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <ul class="navbar-menu">
          <li>
            <a href="#quienes-somos" class="nav-link">
              <span>Quiénes somos</span>
            </a>
          </li>
          <li>
            <a href="#esencia" class="nav-link">
              <span>Esencia</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="page-wrapper">
      <slot />
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.querySelector('.navbar-toggle') as HTMLButtonElement;
        const menu = document.querySelector('.navbar-menu') as HTMLElement;
        
        if (toggle && menu) {
          toggle.addEventListener('click', () => {
            const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!isExpanded));
            menu.setAttribute('data-visible', String(!isExpanded));
          });

          const navLinks = menu.querySelectorAll('.nav-link');
          navLinks.forEach(link => {
            link.addEventListener('click', () => {
              toggle.setAttribute('aria-expanded', 'false');
              menu.setAttribute('data-visible', 'false');
            });
          });

          document.addEventListener('click', (e) => {
            if (!menu.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
              toggle.setAttribute('aria-expanded', 'false');
              menu.setAttribute('data-visible', 'false');
            }
          });
        }
      });
    </script>
  </body>
</html>
