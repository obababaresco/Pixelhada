---
interface Props {
  text: string;
  icon: 'fairy' | 'wand' | 'code' | 'heart';
  delay?: number;
}

const { text, icon, delay = 0 } = Astro.props;

const icons: Record<string, string> = {
  fairy: `<svg viewBox="0 0 32 32" fill="none" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
    <path d="M16 4l1.5 3 3 0.5-2 2.2 0.5 3L16 11l-3 1.7 0.5-3-2-2.2 3-0.5z" fill="var(--color-soft-pink)" opacity="0.8"/>
    <circle cx="16" cy="19" r="3" stroke="var(--color-lavender)" stroke-width="1.2" fill="none"/>
    <path d="M13 22c-1 2-1 5 0 6.5 0.8 1.2 2 1.5 3 1.5s2.2-0.3 3-1.5c1-1.5 1-4.5 0-6.5" stroke="var(--color-lavender)" stroke-width="1.2" fill="none" stroke-linecap="round"/>
    <path d="M10 17c-2-1-4 0-4 2s3 2 4 1M22 17c2-1 4 0 4 2s-3 2-4 1" stroke="var(--color-soft-lilac)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0.6"/>
  </svg>`,
  wand: `<svg viewBox="0 0 32 32" fill="none" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
    <path d="M8 28L24 8" stroke="var(--color-lavender)" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M24 4l1 3 3 1-3 1-1 3-1-3-3-1 3-1z" fill="var(--color-soft-pink)" opacity="0.9"/>
    <circle cx="10" cy="10" r="1" fill="var(--color-periwinkle)" opacity="0.6"/>
    <circle cx="6" cy="20" r="0.8" fill="var(--color-soft-lilac)" opacity="0.5"/>
  </svg>`,
  code: `<svg viewBox="0 0 32 32" fill="none" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 10L6 16l6 6" stroke="var(--color-periwinkle)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M20 10l6 6-6 6" stroke="var(--color-periwinkle)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M18 6l-4 20" stroke="var(--color-lavender)" stroke-width="1.2" stroke-linecap="round" opacity="0.6"/>
    <circle cx="26" cy="6" r="1" fill="var(--color-soft-pink)" opacity="0.5"/>
  </svg>`,
  heart: `<svg viewBox="0 0 32 32" fill="none" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
    <path d="M16 28s-10-6.5-10-13c0-4 3-6 5.5-6 1.8 0 3.5 1 4.5 2.5 1-1.5 2.7-2.5 4.5-2.5 2.5 0 5.5 2 5.5 6 0 6.5-10 13-10 13z" stroke="var(--color-soft-pink)" stroke-width="1.5" fill="none"/>
    <path d="M16 28s-10-6.5-10-13c0-4 3-6 5.5-6 1.8 0 3.5 1 4.5 2.5 1-1.5 2.7-2.5 4.5-2.5 2.5 0 5.5 2 5.5 6 0 6.5-10 13-10 13z" fill="var(--color-soft-pink)" opacity="0.1"/>
    <circle cx="22" cy="8" r="0.8" fill="var(--color-lavender)" opacity="0.5"/>
  </svg>`,
};
---

<div class="manifesto-item animate-on-scroll" style={delay ? `transition-delay: ${delay}ms` : ''}>
  <div class="manifesto-icon" aria-hidden="true">
    <Fragment set:html={icons[icon]} />
  </div>
  <p class="manifesto-text">{text}</p>
</div>

<style>
  .manifesto-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(47, 46, 62, 0.4), rgba(30, 30, 30, 0.3));
    border: 1px solid rgba(196, 181, 224, 0.08);
    transition: opacity 0.8s ease, transform 0.8s ease, background 0.4s ease, border-color 0.4s ease;
  }

  .manifesto-item:hover {
    background: linear-gradient(135deg, rgba(47, 46, 62, 0.6), rgba(30, 30, 30, 0.5));
    border-color: rgba(196, 181, 224, 0.2);
  }

  .manifesto-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    animation: float 4s ease-in-out infinite;
  }

  .manifesto-item:nth-child(2) .manifesto-icon { animation-delay: 0.5s; }
  .manifesto-item:nth-child(3) .manifesto-icon { animation-delay: 1s; }
  .manifesto-item:nth-child(4) .manifesto-icon { animation-delay: 1.5s; }

  .manifesto-text {
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
    font-style: italic;
    color: var(--color-text-white);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @media (max-width: 480px) {
    .manifesto-item {
      padding: 1.25rem 1.5rem;
      gap: 1rem;
    }

    .manifesto-text {
      font-size: 1rem;
    }
  }
</style>
