---
interface Props {
  count?: number;
  class?: string;
}

const { count = 50, class: className = '' } = Astro.props;

const stars = Array.from({ length: count }, (_, i) => {
  const isLarge = i < Math.floor(count * 0.15);
  const isMedium = !isLarge && i < Math.floor(count * 0.4);

  const size = isLarge
    ? Math.random() * 4 + 3
    : isMedium
      ? Math.random() * 3 + 2
      : Math.random() * 2 + 1;

  const opacity = isLarge
    ? Math.random() * 0.3 + 0.7
    : isMedium
      ? Math.random() * 0.3 + 0.5
      : Math.random() * 0.3 + 0.4;

  return {
    top: `${Math.random() * 100}%`,
    left: `${Math.random() * 100}%`,
    size: `${size}px`,
    delay: `${Math.random() * 6}s`,
    duration: `${Math.random() * 3 + 2}s`,
    opacity,
    type: isLarge ? 'large' : isMedium ? 'medium' : 'small',
  };
});

const nebulae = [
  { top: '15%', left: '20%', size: '300px', color: 'rgba(196, 181, 224, 0.08)', blur: '80px', delay: '0s' },
  { top: '60%', left: '70%', size: '250px', color: 'rgba(139, 159, 214, 0.06)', blur: '70px', delay: '3s' },
  { top: '40%', left: '50%', size: '350px', color: 'rgba(232, 160, 191, 0.05)', blur: '90px', delay: '6s' },
];
---

<div class={`starfield ${className}`} aria-hidden="true">
  {nebulae.map((n) => (
    <div
      class="nebula"
      style={`top:${n.top};left:${n.left};width:${n.size};height:${n.size};background:radial-gradient(circle,${n.color} 0%,transparent 70%);filter:blur(${n.blur});animation-delay:${n.delay}`}
    />
  ))}
  {stars.map((star) => (
    <span
      class={`star star--${star.type}`}
      style={`top:${star.top};left:${star.left};width:${star.size};height:${star.size};animation-delay:${star.delay};animation-duration:${star.duration};--star-opacity:${star.opacity}`}
    />
  ))}
</div>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .nebula {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    animation: nebulaPulse 12s ease-in-out infinite;
    opacity: 0.7;
  }

  @keyframes nebulaPulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  .star {
    position: absolute;
    border-radius: 50%;
    animation: twinkle var(--duration, 3s) ease-in-out infinite;
    opacity: 0;
  }

  .star--small {
    background: radial-gradient(circle, rgba(255, 255, 255, 0.95) 0%, rgba(212, 187, 234, 0.5) 50%, transparent 70%);
  }

  .star--medium {
    background: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, rgba(196, 181, 224, 0.7) 40%, rgba(139, 159, 214, 0.3) 70%, transparent 85%);
    box-shadow: 0 0 4px rgba(196, 181, 224, 0.4);
  }

  .star--large {
    background: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, rgba(212, 187, 234, 0.8) 30%, rgba(139, 159, 214, 0.4) 60%, transparent 80%);
    box-shadow: 0 0 8px rgba(196, 181, 224, 0.5), 0 0 16px rgba(139, 159, 214, 0.2);
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.15; transform: scale(0.7); }
    50% { opacity: var(--star-opacity, 0.7); transform: scale(1); }
  }
</style>
